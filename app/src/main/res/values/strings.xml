<resources>
    <string name="vault_key_error">Código LUMA-KEY: la autenticación terminó, pero no se pudo recuperar la clave de cifrado. Vuelve a desbloquear. Si persiste, comunica este código. No borres datos ni desinstales: una clave perdida necesita tu copia cifrada.</string>
    <string name="vault_database_error">Código LUMA-DB: se recuperó la clave, pero falló la apertura, migración o verificación de la base. Comunica este código para revisar el fallo. No borres datos ni desinstales la app.</string>
    <string name="explore_flow_legend">Verde: ingresos · Rojo: gastos. Toca un intervalo para ver sus movimientos.</string>
    <string name="security_description">Base cifrada con SQLCipher y claves protegidas por Android Keystore. Se utiliza hardware seguro cuando está disponible; en otros dispositivos se admite protección por software, con menor resistencia si el sistema está comprometido. Se mantiene la autenticación del teléfono y el bloqueo al salir.</string>
    <string name="security_limits">Ningún sistema garantiza protección absoluta en un dispositivo comprometido mientras los datos están abiertos.</string>
    <string name="security_export">Crear copia cifrada</string>
    <string name="security_import">Restaurar copia cifrada</string>
    <string name="security_verify">Verificar copia</string>
    <string name="security_password_new">Elige una contraseña independiente de al menos 20 caracteres. Recomendamos una frase larga de palabras aleatorias.</string>
    <string name="security_password_existing">Introduce la contraseña de esta copia.</string>
    <string name="security_password">Contraseña de la copia</string>
    <string name="security_confirm_password">Repite la contraseña</string>
    <string name="security_password_error">Las contraseñas deben coincidir y tener al menos 20 caracteres.</string>
    <string name="security_backup_warning">El destino que elijas puede ser un proveedor en la nube. Solo recibirá el archivo cifrado. Conserva la contraseña: Luma no puede recuperarla. No existen copias automáticas.</string>
    <string name="security_exported">Copia cifrada guardada.</string>
    <string name="security_restored">Copia restaurada correctamente.</string>
    <string name="security_failed">No se pudo completar la operación. Comprueba contraseña, archivo y espacio disponible. Los fallos de validación conservan los datos actuales.</string>
    <string name="security_replace">Sustituir datos actuales</string>
    <string name="security_replace_counts">Contenido de la copia: movimientos %1$d; categorías %2$d; reglas %3$d. Sustituirá todos los datos actuales; no se fusionarán. Crea antes una copia si deseas conservarlos.</string>
    <string name="security_erase">Borrar todos los datos</string>
    <string name="security_erase_warning">Se eliminarán los datos locales y las claves. Esta acción es irreversible sin una copia cifrada. Las copias externas no se borrarán.</string>
    <string name="security_privacy_title">Privacidad</string>
    <string name="security_privacy">Luma procesa tus finanzas en este dispositivo. No incluye cuentas, publicidad, analítica ni conexión a servidores. Los archivos solo salen cuando eliges una copia cifrada. Elimina tus datos desde esta pantalla. La autenticación la gestiona Android: Luma no recibe tus datos biométricos ni el PIN del teléfono.</string>
